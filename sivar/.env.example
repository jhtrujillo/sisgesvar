# ─── Frontend (Vite) ───────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:8000
# Origen desde el que se sirve el frontend (para EventSource/fetch al micro-servicio)
VITE_BIOJAVA_API_URL=http://127.0.0.1:3001

# ─── Micro-servicio BioJava (biojava-runner.js) ────────────────────
# Debe escuchar SOLO en loopback; expóngalo por Nginx si hace falta.
BIOJAVA_HOST=127.0.0.1
BIOJAVA_PORT=3001

# Secreto JWT: DEBE ser idéntico a JWT_SECRET de api_sivar/.env (algoritmo HS256).
# Permite que el micro-servicio valide el mismo token que emite Laravel.
BIOJAVA_JWT_SECRET=coloque_aqui_el_mismo_valor_que_JWT_SECRET_de_laravel

# Orígenes permitidos por CORS (separados por coma). Nunca use '*'.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Raíz de datos genómicos: TODAS las rutas de entrada se confinan aquí.
# En el servidor Linux:
BIOJAVA_DATA_ROOT=/biodata5/proyectos/genomica_comparativa
# En desarrollo (Mac) sería, por ejemplo:
# BIOJAVA_DATA_ROOT=/Users/estuvar4/Documents/2. software/17.biojava

# Carpeta de salidas (servida en /public/results/<jobId>/)
BIOJAVA_OUTPUT_ROOT=./public/results

# Límites operativos
BIOJAVA_MAX_JOBS=2
BIOJAVA_JOB_TIMEOUT_MS=900000
BIOJAVA_MAX_LOG_LINES=2000
